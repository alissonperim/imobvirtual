model OtpChallenge {
  id          String     @id @default(uuid())
  destination String
  purpose     OtpPurpose
  channel     OtpChannel
  accountId   String?
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  account Account? @relation(fields: [accountId], references: [id])

  @@map("otp_challenges")
}
