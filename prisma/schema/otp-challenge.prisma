model OtpChallenge {
  id                              String     @id @default(nanoid())
  destination                     String
  purpose                         OtpPurpose
  channel                         OtpChannel
  account_id                      String?
  code_hash                       String
  expires_at                      DateTime
  attempts                        Int        @default(0)
  consumed_at                     DateTime?
  created_at                      DateTime  @default(now())
  updated_at                      DateTime  @updatedAt
  deleted_at                      DateTime?
  created_by                      String?
  updated_by                      String?
  deleted_by                      String?

  account Account? @relation(fields: [account_id], references: [id])

  @@map("otp_challenges")
}
