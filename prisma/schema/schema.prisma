generator client {
  provider = "prisma-client"
  output = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  OWNER
  RENTER
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum OtpPurpose {
  SIGN_IN
  SIGN_UP
  CHANGE_EMAIL
  CHANGE_PHONE
  PASSWORD_RECOVERY
}

enum OtpChannel {
  SMS
  WHATSAPP
}

enum MaritalStatus {
  MARIED
  SINGLE
  DIVORCED
  WIDOWER
}

enum PropertyStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
}

enum ContractStatus {
  ACTIVE
  FINISHED
  CANCELLED
}
